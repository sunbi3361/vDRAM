// BFS, topo-warp-centric. MGPUSim-friendly.
//
// Control-flow note: previous versions hit SOP2 opcode 21 (s_orn2_b64) which
// the simulator does not implement. That comes from EXEC-mask manipulation
// generated by `return`/`break`/`continue` inside nested loops. Here:
//   - the outer chunk loop is bounded by a pre-computed `chk` count, so no
//     mid-loop `return`/`continue`;
//   - the inner edge loop has no `break`;
//   - the only branch is a leaf-level `if` around the visit body.

#define INF       0xffffffffu
#define WARP_SZ   64
#define CHUNK_SZ  64

__kernel void bfs_data_warp_centric_kernel(
    __global uint*       vplist,
    __global const uint* offsets,
    __global const uint* edges,
    __global uint*       state,   // [0]=changed, [1]=curr_level, [2]=num_nodes
    uint                 pad0)
{
    uint tid       = (uint)get_global_id(0);
    uint lane_id   = tid & (WARP_SZ - 1u);
    uint warp_id   = tid / WARP_SZ;
    uint v_base    = warp_id * CHUNK_SZ;

    uint curr_level = state[1];
    uint num_nodes  = state[2];
    uint next_lvl   = curr_level + 1u;

    // Bound the chunk to [0, CHUNK_SZ] without early-exit.
    uint chk = 0u;
    if (v_base < num_nodes) {
        uint room = num_nodes - v_base;
        chk = (room < CHUNK_SZ) ? room : CHUNK_SZ;
    }

    for (uint i = 0u; i < chk; i++) {
        uint v = v_base + i;
        uint active = (vplist[v] == curr_level) ? 1u : 0u;

        // Read offsets unconditionally (safe because v < num_nodes).
        uint nbr_off = offsets[v];
        uint nbr_end = offsets[v + 1];
        uint num_nbr = active ? (nbr_end - nbr_off) : 0u;

        for (uint k = lane_id; k < num_nbr; k += WARP_SZ) {
            uint dst = edges[k + nbr_off];
            if (vplist[dst] == INF) {
                vplist[dst] = next_lvl;
                state[0]    = 1u;
            }
        }
    }
}
